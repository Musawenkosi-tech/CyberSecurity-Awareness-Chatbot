<Window x:Class="CyberSecurity_Awareness_Chatbot.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Cybersecurity Tasks" Height="460" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="My Cybersecurity Tasks"
                   FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>

        <ListView x:Name="TaskList" Grid.Row="1" Background="White" BorderBrush="#D1D5DB">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Title" Width="170" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Reminder" Width="130" DisplayMemberBinding="{Binding ReminderText}"/>
                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Mark completed" Width="130" Padding="8,6" Background="#16A34A" Foreground="White"
                    BorderThickness="0" Click="CompleteButton_Click"/>
            <Button Content="Delete" Width="90" Padding="8,6" Margin="8,0,0,0" Background="#DC2626" Foreground="White"
                    BorderThickness="0" Click="DeleteButton_Click"/>
            <Button Content="Refresh" Width="90" Padding="8,6" Margin="8,0,0,0" Background="#64748B" Foreground="White"
                    BorderThickness="0" Click="RefreshButton_Click"/>
            <Button Content="Close" Width="90" Padding="8,6" Margin="8,0,0,0" Background="#2563EB" Foreground="White"
                    BorderThickness="0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
