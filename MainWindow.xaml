<Window x:Class="CyberSecurity_Awareness_Chatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="700" Width="820"
        MinHeight="520" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        <!-- Row 0: title header -->
        <TextBlock Grid.Row="0" Text="CYBERSECURITY AWARENESS BOT"
                   FontSize="24" FontWeight="Bold" Foreground="#A6E3A1"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

       
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button x:Name="HistoryButton" Content="History" Width="120" Padding="8,6"
                    Style="{StaticResource RoundButton}" Background="#64748B"
                    Click="HistoryButton_Click"/>
            <Button x:Name="ClearButton" Content="Clear" Width="80" Padding="8,6" Margin="8,0,0,0"
                    Style="{StaticResource RoundButton}" Background="#DC2626"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <!-- Row 2: the chat. Two layers share the same space; only one is visible at a time. -->
        <Border Grid.Row="2" Background="#2A2A3C" BorderBrush="#45475A" BorderThickness="1" CornerRadius="6">
            <Grid>
                <!-- Chat bubbles are added to MessagePanel from the code -->
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="MessagePanel"/>
                </ScrollViewer>

                
                <TextBox x:Name="HistoryBox" Visibility="Collapsed" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="13" Background="White" Foreground="#1F2937"
                         BorderThickness="0" Padding="12"/>
            </Grid>
        </Border>

       
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" FontSize="14" Padding="10"
                     Background="White" Foreground="#1F2937" CaretBrush="#1F2937"
                     BorderBrush="#D1D5DB" VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                    Width="90" Margin="10,0,0,0" FontSize="14" Padding="8,8"
                    Style="{StaticResource RoundButton}" Background="#2563EB"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
